# Copy this to .env (same directory) and fill in the values.
# .env is gitignored; this sample is committed and holds no real secrets.
# scripts/stack.sh loads .env before running any command, and each app's
# setup.sh consumes the keys it needs.

# --- Homarr ----------------------------------------------------------------
# Encrypts stored credentials. Exactly 64 hex characters. Generate once:
#   printf 'SECRET_ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)"
# Changing it after Homarr has data makes that data undecryptable.
SECRET_ENCRYPTION_KEY=

# --- Traefik / Tailscale ----------------------------------------------------
# Tailnet name Traefik requests its TLS certificate for, e.g.
# host.tailnet.ts.net. Leave empty to detect it at setup time from
# `tailscale status --json` (Self.DNSName); set it only to override that.
# scripts/stack.sh setup traefik renders it into the gitignored
# apps/traefik/config/dynamic/tailnet.yml.
TAILNET_DOMAIN=

# --- qBittorrent ------------------------------------------------------------
# CIDRs (semicolon-separated) whose X-Forwarded-* headers qBittorrent trusts.
# Empty means every address (0.0.0.0/0; ::/0): this host is reachable only
# over the tailnet and the WebUI is never published, so nothing untrusted can
# spoof the header. Set it only to narrow that.
QBITTORRENT_TRUSTED_PROXIES=
