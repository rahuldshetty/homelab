# Copy to .env and fill in. .env is gitignored; this sample holds no secrets.
# scripts/stack.sh loads it before any command; app setups read the keys.

# --- Homarr ----------------------------------------------------------------
# Encrypts stored credentials; 64 hex chars. Changing it makes existing data
# undecryptable. Generate once:
#   printf 'SECRET_ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)"
SECRET_ENCRYPTION_KEY=

# --- Traefik / Tailscale ---------------------------------------------------
# TLS name Traefik requests its cert for, e.g. host.tailnet.ts.net.
# Empty: detect it from `tailscale status --json`.
TAILNET_DOMAIN=

# --- qBittorrent -----------------------------------------------------------
# X-Forwarded-* trusted CIDRs, semicolon-separated. Empty means every address
# (0.0.0.0/0; ::/0), safe here because the WebUI is never published.
QBITTORRENT_TRUSTED_PROXIES=
