[Unit]
Description=Homarr dashboard

[Container]
ContainerName=homarr
Image=ghcr.io/homarr-labs/homarr:v1.77.2
Network=media.network
# Holds SECRET_ENCRYPTION_KEY.
EnvironmentFile=%h/.config/homarr/env
# SQLite database lives at /appdata/db/db.sqlite; the directory is nocow.
Volume=%h/media/appdata/homarr:/appdata:Z
NoNewPrivileges=true
Memory=1g
# No ReadOnly/DropCapability and no podman socket: the image runs nginx + redis
# + node, starts as root to su-exec into an app user, and writes outside
# /appdata. The socket is deliberately absent -- Homarr's docker integration
# would hand the dashboard the container API.
Label=traefik.enable=true
Label=traefik.http.routers.homarr.rule=PathPrefix(`/`)
Label=traefik.http.routers.homarr.entrypoints=websecure
# TLS via the default store's cert, fetched by traefik's tailnet routers.
Label=traefik.http.routers.homarr.tls=true
# Lowest priority: specific path routers (/sonarr) must win over this one.
Label=traefik.http.routers.homarr.priority=1
Label=traefik.http.services.homarr.loadbalancer.server.port=7575

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
