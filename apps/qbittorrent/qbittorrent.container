[Unit]
Description=qBittorrent

[Container]
ContainerName=qbittorrent
Image=lscr.io/linuxserver/qbittorrent:5.2.3_v2.0.15-ls478
Network=media.network
# Rootless podman maps container root onto the host user, so the app has to run
# as root inside for downloads and state to stay owned by us. LSIO's init drops
# to `abc`, hence PUID/PGID=0; the image's s6 also needs to stay root so it can
# own /run and chown the mounts. Same model as homarr: nothing here is root on
# the host, rootless podman is the boundary.
#
# LSIO's non-root mode would be nicer, but s6 then demands /run be owned by that
# uid, and podman's --tmpfs has no uid= option to arrange it.
Environment=PUID=0
Environment=PGID=0
Environment=TZ=Asia/Kolkata
# WebUI stays container-internal; Traefik's service label points at this port.
Environment=WEBUI_PORT=8080
# Must equal the two PublishPort lines below, or peers knock on a closed door.
Environment=TORRENTING_PORT=6881
# State and downloads; both nocow, see setup.sh.
Volume=%h/media/appdata/qbittorrent:/config:Z
Volume=%h/media/downloads:/downloads:Z
# WebUI is not published: Traefik reaches :8080 over media.network, and it has
# no authentication at all (see qBittorrent.conf), so the tailnet is the gate.
# The peer port is published, or the client stays passive -- `setup.sh` checks
# the firewall for it.
PublishPort=6881:6881
PublishPort=6881:6881/udp
NoNewPrivileges=true
Memory=2g
# No ReadOnly/DropCapability=all: the s6 init chowns the volumes and setuid's to
# abc, so it needs CAP_CHOWN/CAP_SETUID/CAP_SETGID inside the user namespace.
Label=traefik.enable=true
Label=traefik.http.routers.qbittorrent.rule=PathPrefix(`/qbit`)
Label=traefik.http.routers.qbittorrent.entrypoints=websecure
# TLS with the default store's certificate. The ts.net cert is fetched once, by
# the Tailscale resolver on the routers in
# apps/traefik/config/dynamic/tailnet.yml, so the tailnet name is not repeated
# here and this router carries no certResolver of its own.
Label=traefik.http.routers.qbittorrent.tls=true
Label=traefik.http.routers.qbittorrent.middlewares=qbittorrent-slash,qbittorrent-strip
# qBittorrent cannot be told about a path prefix and its pages use relative
# URLs, so the browser has to land on /qbit/ and Traefik has to cut the prefix.
# Both `$$` are literal `$` by the time podman sees them: systemd eats one when
# it runs the generated unit.
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.regex=^(.*)/qbit$$
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.replacement=$$1/qbit/
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.permanent=true
Label=traefik.http.middlewares.qbittorrent-strip.stripprefix.prefixes=/qbit
Label=traefik.http.services.qbittorrent.loadbalancer.server.port=8080

[Service]
Restart=always
# A cold image pull can exceed systemd's 90s start limit.
TimeoutStartSec=900

[Install]
WantedBy=default.target
