[Unit]
Description=qBittorrent

[Container]
ContainerName=qbittorrent
Image=lscr.io/linuxserver/qbittorrent:5.2.3_v2.0.15-ls478
Network=media.network
# Rootless podman maps container root to the host user, so root inside is not
# root on the host; s6 needs it to own /run and chown the mounts, and LSIO's
# init drops to `abc`, hence PUID/PGID=0. LSIO's non-root mode would need /run
# owned by that uid, which podman's --tmpfs cannot arrange.
Environment=PUID=0
Environment=PGID=0
Environment=TZ=Asia/Kolkata
# WebUI stays container-internal; Traefik's service label points here.
Environment=WEBUI_PORT=8080
# Must match the PublishPort lines below, or peers knock on a closed door.
Environment=TORRENTING_PORT=6881
# State and downloads, both nocow; see setup.sh.
Volume=%h/media/appdata/qbittorrent:/config:Z
# `:z`, not `:Z`: the Samba share (apps/samba) cannot satisfy :Z's MCS categories.
Volume=%h/media/downloads:/downloads:z
# WebUI is not published: Traefik reaches :8080 over media.network and the
# tailnet is the only gate (no auth, see qBittorrent.conf). The peer port is
# published; setup.sh checks the firewall for it.
PublishPort=6881:6881
PublishPort=6881:6881/udp
NoNewPrivileges=true
Memory=1g
# No ReadOnly/DropCapability: s6 chowns the volumes and setuid's to abc.
Label=traefik.enable=true
Label=traefik.http.routers.qbittorrent.rule=PathPrefix(`/qbit`)
Label=traefik.http.routers.qbittorrent.entrypoints=websecure
# TLS via the default store's cert, fetched by traefik's tailnet routers.
Label=traefik.http.routers.qbittorrent.tls=true
Label=traefik.http.routers.qbittorrent.middlewares=qbittorrent-slash,qbittorrent-strip
# qBittorrent has no path-prefix setting and its pages use relative URLs, so
# the browser must land on /qbit/ and Traefik cuts the prefix. `$$` is a literal
# `$` once podman sees the label (systemd eats one).
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.regex=^(.*)/qbit$$
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.replacement=$$1/qbit/
Label=traefik.http.middlewares.qbittorrent-slash.redirectregex.permanent=true
Label=traefik.http.middlewares.qbittorrent-strip.stripprefix.prefixes=/qbit
Label=traefik.http.services.qbittorrent.loadbalancer.server.port=8080

[Service]
Restart=always
# A cold image pull can exceed systemd's 90s start limit.
TimeoutStartSec=900

[Install]
WantedBy=default.target
