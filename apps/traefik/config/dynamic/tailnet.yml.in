# GENERATED FILE -- edit tailnet.yml.in, then: scripts/stack.sh setup traefik
#
# Tailnet-side dashboard/API routers. setup.sh substitutes the ts.net name from
# .env TAILNET_DOMAIN or `tailscale status --json`. This is the one place the
# name is stated: Traefik's Tailscale resolver fetches the certificate from a
# router's tls.domains[].main, and every other router serves that certificate
# from the default TLS store.
http:
  routers:
    traefik-api-tailnet:
      entryPoints: [websecure]
      rule: "PathPrefix(`/traefik/api`)"
      service: api@internal
      tls:
        certResolver: tailscale
        domains:
          - main: "@TAILNET_DOMAIN@"

    traefik-ui-tailnet:
      entryPoints: [websecure]
      rule: "PathPrefix(`/traefik`)"
      service: api@internal
      middlewares: [traefik-slash, traefik-ui-rewrite]
      tls:
        certResolver: tailscale
        domains:
          - main: "@TAILNET_DOMAIN@"
